+        return {'path': str(path), 'exists': False}
+    stat = path.stat()
+    return {'path': str(path), 'exists': True, 'bytes': stat.st_size,
+            'mtime_ns': stat.st_mtime_ns, 'fingerprint_method': 'path_size_mtime_no_hash'}
+
