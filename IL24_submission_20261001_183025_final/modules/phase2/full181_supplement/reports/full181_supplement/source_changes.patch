+from pathlib import Path, PurePosixPath
+from prepare_full181_supplement import write_json
+from run_full181_supplement import ROOT, OUT, LOG, validate_artifacts, now
+
+REMOTE = PurePosixPath('/mnt/il24_full181_supplement_20260921')
+CONSOLIDATED = PurePosixPath('/mnt/pxh/teeth/phase2/full181_supplement')
+
+
+def main():
+    remote_audit = json.loads((OUT / 'server_artifact_validation.json').read_text(encoding='utf-8'))
+    if remote_audit['validated_tasks'] != 30 or remote_audit['failed_or_missing']:
+        raise ValueError('Remote 30-model artifact acceptance must precede transfer acceptance')
+    with (OUT / 'full181_model_summary.csv').open(encoding='utf-8-sig', newline='') as f:
