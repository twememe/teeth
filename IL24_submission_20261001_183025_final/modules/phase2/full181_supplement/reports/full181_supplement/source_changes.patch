+"""Residue-coordinate contract tests; no prediction, smoke, or digest tests."""
+import importlib
+from pathlib import Path
+import sys
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+
+
+class MappingContractTests(unittest.TestCase):
+    def setUp(self):
+        self.assertTrue((ROOT / "src/full181_contract.py").exists(),
+                        "The explicit Full181 mapping implementation is absent")
+        self.c = importlib.import_module("full181_contract")
+        self.sequences = self.c.read_constructs(ROOT)
+
+    def test_full181_landmarks_preserve_terminal_leucine(self):
+        rows = self.c.build_mapping(self.sequences["Full181"], "Full181")
+        for local, project, aa in [(1, 1, "M"), (27, 27, "Q"),
+                                   (74, 74, "N"), (160, 160, "A"),
+                                   (180, 180, "H"), (181, 181, "L")]:
+            with self.subTest(local=local):
+                self.assertEqual((rows[local-1]["local_position"],
+                                  rows[local-1]["project_position"],
+                                  rows[local-1]["amino_acid"]),
+                                 (local, project, aa))
+
+    def test_legacy_constructs_keep_their_verified_offset(self):
+        for construct in ("Native155", "Immunogen134"):
+            rows = self.c.build_mapping(self.sequences[construct], construct)
+            for local, project, aa in [(1, 27, "Q"), (48, 74, "N"),
+                                       (134, 160, "A")]:
+                with self.subTest(construct=construct, local=local):
+                    self.assertEqual((rows[local-1]["project_position"],
+                                      rows[local-1]["amino_acid"]), (project, aa))
+        native = self.c.build_mapping(self.sequences["Native155"], "native")
+        self.assertEqual((native[154]["project_position"], native[154]["amino_acid"]),
+                         (181, "L"))
+
+    def test_nvs_sequon_is_74_in_full_and_48_in_legacy_constructs(self):
+        self.assertEqual(self.sequences["Full181"][73:76], "NVS")
+        self.assertEqual(self.sequences["Full181"][47], "F")
+        for construct in ("Native155", "Immunogen134"):
+            self.assertEqual(self.sequences[construct][47:50], "NVS")
+
+    def test_truncated_full_sequence_cannot_be_silently_accepted(self):
+        with self.assertRaisesRegex(ValueError, "181"):
+            self.c.build_mapping(self.sequences["Full181"][:-1], "full181")
+
+    def test_sequence_substitution_reports_affected_position(self):
+        sequence = self.sequences["Full181"]
+        with self.assertRaisesRegex(ValueError, "74"):
+            self.c.build_mapping(sequence[:73] + "A" + sequence[74:], "Full181")
+
+    def test_pdb_renumbering_and_insertion_labels_use_sequence_positions(self):
+        residues = self.c.read_pdb_chains(ROOT / "data/AF-Q925S4-F1-model_v6.pdb")["A"]
+        changed = [self.c.ResidueRecord((" ", 100+i, "A" if i == 74 else " "),
+                                       residue.resname)
+                   for i, residue in enumerate(residues, 1)]
+        result = self.c.build_residue_map(changed, "Full181")
+        row = result["residue_map"][(" ", 174, "A")]
+        self.assertEqual((row["local_position"], row["project_position"], row["amino_acid"]),
+                         (74, 74, "N"))
+        self.assertTrue(result["metadata"]["has_insertion_codes"])
+        self.assertFalse(result["metadata"]["local_numbering_contiguous"])
+
+    def test_uniquely_missing_residue_maps_explicitly_and_blocks_complete_acceptance(self):
+        residues = self.c.read_pdb_chains(ROOT / "data/AF-Q925S4-F1-model_v6.pdb")["A"]
+        missing = [r for r in residues if r.id[1] != 74]
+        with self.assertRaisesRegex(ValueError, "incomplete"):
+            self.c.build_residue_map(missing, "Full181")
+        result = self.c.build_residue_map(missing, "Full181", require_complete=False)
+        self.assertEqual(result["metadata"]["missing_local_positions"], [74])
+        self.assertEqual(result["residue_map"][(" ", 75, " ")]["project_position"], 75)
+
+    def test_ambiguous_missing_residue_is_rejected(self):
+        residues = self.c.read_pdb_chains(ROOT / "data/AF-Q925S4-F1-model_v6.pdb")["A"]
+        missing = [r for r in residues if r.id[1] != 15]
+        with self.assertRaisesRegex(ValueError, "ambiguous"):
+            self.c.build_residue_map(missing, "Full181", require_complete=False)
+
+    def test_legacy_structures_map_with_original_antibody_sequences(self):
+        path = ROOT / "results/native_blind_seed8.pdb"
+        result = self.c.build_structure_mapping(path, "Native155", ROOT)
+        self.assertEqual(result["A"]["residue_map"][(" ", 48, " ")]["project_position"], 74)
+        self.assertEqual(result["H"]["metadata"]["observed_length"], 119)
+        self.assertEqual(result["L"]["metadata"]["observed_length"], 106)
