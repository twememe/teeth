+            state = json.loads((OUT / 'raw' / condition / f'seed{seed}/run_state.json').read_text(encoding='utf-8'))
+            if (state['construct'],state['condition'],state['seed'],state['status']) != ('Full181',condition,seed,'complete'):
+                raise ValueError('Transferred run state identity or status differs')
+            checked = validate_artifacts(condition, seed)
+            for source, local in zip(state['artifact_fingerprints'], checked['artifact_fingerprints']):
+                rel = PurePosixPath(source['path']).relative_to(REMOTE)
+                if (ROOT / Path(str(rel))).resolve() != Path(local['path']).resolve() or source['bytes'] != local['bytes']:
+                    raise ValueError('Transferred artifact source/path/size mismatch')
+            confidence = json.loads(Path(checked['confidence_path']).read_text(encoding='utf-8'))
+            summary = summaries[(condition,seed)]
+            for field in ('confidence_score','ptm','iptm','complex_plddt'):
+                if abs(confidence[field]-float(summary[field])) > 1e-12:
+                    raise ValueError('Transferred per-seed summary differs from original confidence JSON')
+            command = json.loads((LOG / condition / f'seed{seed}/command.json').read_text(encoding='utf-8'))
+            if command != state['provenance']['command']:
+                raise ValueError('Transferred command differs from original task provenance')
+            for field in ('pdb_path','confidence_path','pae_path'):
+                source = state[field]
+                rows.append(dict(construct='Full181',condition=condition,seed=seed,artifact=field,
+                                 source_path=source,local_path=checked[field],
+                                 consolidated_server_path=str(CONSOLIDATED / PurePosixPath(source).relative_to(REMOTE)),
+                                 status='passed',hash_verified=False))
+    with (OUT / 'artifact_path_map.csv').open('w', encoding='utf-8', newline='') as f:
+        writer=csv.DictWriter(f,fieldnames=list(rows[0]));writer.writeheader();writer.writerows(rows)
