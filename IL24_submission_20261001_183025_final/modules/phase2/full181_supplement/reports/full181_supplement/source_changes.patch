+CONSTRUCTS = {
+    "Full181": {"project_start": 1, "project_end": 181, "offset": 0,
+                "length": 181, "filename": "IL24_full_1_181.fasta"},
+    "Native155": {"project_start": 27, "project_end": 181, "offset": 26,
+                  "length": 155, "filename": "IL24_native_27_181.fasta"},
