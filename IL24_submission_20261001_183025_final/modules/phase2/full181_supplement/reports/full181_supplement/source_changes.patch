+
+def number(value):
+    try:
+        result = float(value)
+        return result if math.isfinite(result) else None
+    except (TypeError, ValueError):
+        return None
+
+
+def residues(value):
+    if value is None or str(value).strip().upper() in ("NA", "NAN", "UNKNOWN"):
+        return None
+    return {int(x) for x in str(value).split(";") if x.strip()}
+
+
+def joined(values):
