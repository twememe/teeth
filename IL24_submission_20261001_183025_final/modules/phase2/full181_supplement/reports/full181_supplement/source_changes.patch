+        elif line.strip():
+            if name is None:
+                raise ValueError(f"Sequence before FASTA header in {path}")
+            records[name] += "".join(line.split()).upper()
+    if not records or any(not value for value in records.values()):
+        raise ValueError(f"Empty FASTA sequence in {path}")
+    return records
+
