+    result=dict(validated_utc=now(),accepted_local_models=30,artifact_mappings=len(rows),
+                original_run_states_modified=False,remote_weight_checks_replaced_by_local_guess=False,
+                remote_validation_source=str(OUT/'server_artifact_validation.json'),
+                checks='exact sequences; finite PDB/confidence/406x406 PAE; source path/size; exact command; confidence-summary linkage',
+                hashes_computed=False)
