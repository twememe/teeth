+def fasta(path):
+    records = {}
+    key = None
+    for raw in Path(path).read_text(encoding='utf-8-sig').splitlines():
+        line = raw.strip()
+        if line.startswith('>'):
+            key = line[1:].split()[0]
+            if key in records:
+                raise ValueError(f'duplicate FASTA record: {key}')
+            records[key] = ''
+        elif line:
+            if key is None:
+                raise ValueError('FASTA sequence before header')
+            records[key] += line.upper()
+    return records
